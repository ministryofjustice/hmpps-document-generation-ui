{% extends "partials/layout.njk" %}
{%- from "moj/components/sub-navigation/macro.njk" import mojSubNavigation -%}
{%- from "govuk/components/button/macro.njk" import govukButton -%}
{%- from "govuk/components/table/macro.njk" import govukTable -%}

{% set fullWidth = true %}
{% set pageTitle = 'Document generation' %}

{% block innerContent %}
  <h1 class="govuk-heading-l govuk-!-margin-bottom-6">Document generation</h1>

  {% set tabs = [] %}
  {% for grouping in groupings %}
    {% set tabs = (tabs.push(
      {
        text: grouping.name,
        href: '?grouping=' + grouping.code,
        active: activeGroupingCode === grouping.code
      }
    ), tabs) %}
  {% endfor %}

  {{ mojSubNavigation({
    label: "Navigation",
    items: tabs
  }) }}

  <div class="moj-page-header-actions">
    <div class="moj-page-header-actions__title govuk-!-width-two-thirds"></div>
    <div class="moj-page-header-actions__actions">
      <div class="moj-button-group moj-button-group--inline">
        {{ govukButton({
          text: "Add a template",
          href: "/add-template?grouping=" + activeGroupingCode,
          preventDoubleClick: true
        }) }}
      </div>
    </div>
  </div>

  {% set rows = [] %}
  {% for template in templates %}
    {% set rows = (rows.push([
      {
        text: template.name
      },
      {
        text: '1 January 2001'
      },
      {
        classes: 'govuk-link govuk-link--no-visited-state',
        html: '<a class="govuk-link govuk-link--no-visited-state" href="/edit-template/' + template.code + '">Edit<span class="govuk-visually-hidden"> for ' + template.name + '</span></a>'
      },
      {
        classes: 'govuk-link govuk-link--no-visited-state',
        html: '<a class="govuk-link govuk-link--no-visited-state" href="/generate-document/' + template.code + '">Generate document<span class="govuk-visually-hidden"> for ' + template.name + '</span></a>',
        format: "numeric"
      }
    ]), rows) %}
  {% endfor %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ govukTable({
        firstCellIsHeader: false,
        head: [
          {
            text: "Name"
          },
          {
            text: "Updated on"
          },
          {
            text: "Actions"
          },
          {
            text: "",
            format: "numeric"
          }
        ],
        rows: rows
      }) }}
    </div>
  </div>
{% endblock %}
